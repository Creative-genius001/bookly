APP_ENV=development
PORT=8080
API_BASE_URL=http://localhost:8080
# Used to build password-reset links sent by email.
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=
LOG_FORMAT=
LOG_ADD_SOURCE=

DATABASE_URL=
DB_SLOW_QUERY_THRESHOLD_MS=
DB_LOG_SQL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=

JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=
REFRESH_TOKEN_TTL_HOURS=

PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=
PAYSTACK_CALLBACK_URL=
BOOKING_AMOUNT_KOBO=
# Platform commission % withheld from each booking before crediting the shop
# wallet. Requires Paystack Transfers enabled for withdrawals to work.
PLATFORM_FEE_PERCENT=0

EMAIL_DRIVER=
RATE_LIMIT_PER_MINUTE=

# SMTP email delivery. Leave SMTP_HOST/SMTP_FROM empty to log emails instead of
# sending them. Port 465 = implicit TLS; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false

# Cloudinary image uploads (POST /uploads). Leave empty to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bookly
